# Copiar a .env (NO subir .env al repositorio ni incluirlo en el zip).
# En producción estas variables se configuran en Netlify: Site configuration > Environment variables.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=misiones_espaciales

# Clave para firmar los JWT (generar una larga y aleatoria, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
JWT_EXPIRES_IN=2h

# Solo para el script de seed (npm run db:seed): crea/actualiza el usuario administrador.
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=
ADMIN_PASSWORD=
